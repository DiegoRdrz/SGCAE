            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/access/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "access", "register"]
            }
          }
        },
        {
          "name": "4. DENIED: Suspended Credential (CRD-8888)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credentialCode\": \"CRD-8888\",\n  \"accessPointId\": \"{{accessPointId}}\",\n  \"movementType\": \"Entry\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/access/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "access", "register"]
            }
          }
        },
        {
          "name": "5. DENIED: Unknown Credential",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credentialCode\": \"CRD-UNKNOWN-999\",\n  \"accessPointId\": \"{{accessPointId}}\",\n  \"movementType\": \"Entry\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/access/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "access", "register"]
            }
          }
        }
      ]
    },
