    {
      "name": "Access Control",
      "item": [
        {
          "name": "1. Entry GRANTED (Active employee and valid credential)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credentialCode\": \"CRD-1001\",\n  \"accessPointId\": \"{{accessPointId}}\",\n  \"movementType\": \"Entry\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/access/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "access", "register"]
            }
          }
        },
        {
          "name": "2. Exit GRANTED",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credentialCode\": \"CRD-1001\",\n  \"accessPointId\": \"{{accessPointId}}\",\n  \"movementType\": \"Exit\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/access/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "access", "register"]
            }
          }
        },
        {
          "name": "3. DENIED: Inactive Employee / Revoked Credential (CRD-9999)",
